{
  "name": "Telegram Car DB",
  "nodes": [
    {
      "parameters": {
        "updateMethod": "getUpdates",
        "outputPropertyName": "message"
      },
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "// Parse commands: accept plain car number or /find <car_number>\nconst msg = $json.message || {}\nconst text = (msg.text || '').trim()\nlet command = ''\nlet query = text\nif(text.startsWith('/')){ const parts = text.split(/\\s+/); command = parts[0]; query = parts.slice(1).join(' '); }\nreturn [{ json: { command, query: query.trim(), chatId: msg.chat && msg.chat.id, from: msg.from } }];"
      },
      "name": "Parse Command",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [],
          "number": [],
          "string": [
            {
              "value1": "={{$json[\"query\"] !== ''}}"
            }
          ]
        }
      },
      "name": "Has Query",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "sheetId": "=\"1SRQ-4v4vKqWFeoh7sL8wiY_XtuSM-hGTQDw9a6iP7KY\"",
        "range": "A:G",
        "options": {}
      },
      "name": "Google Sheets - Read All",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [950, 200]
    },
    {
      "parameters": {
        "functionCode": "// Filter rows by partial match on car_number (case-insensitive)\nconst q = ($json.query||'').toLowerCase();\nconst rows = items.map(i=>i.json).filter(r=>r.car_number && r.car_number.toLowerCase().includes(q));\nif(rows.length===0){ return [{json:{reply:`No matches found for \"${$json.query}\"`}}]; }\nlet reply = 'Matches:\\n';\nrows.forEach((r,idx)=>{ reply += (idx+1)+'. '+r.car_number + (r.owner_name? ' - '+r.owner_name : '') +'\\n'; });\nreturn [{json:{reply}}];"
      },
      "name": "Filter Matches",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "chatId": "={{$json.chatId}}",
        "text": "={{$json.reply}}"
      },
      "name": "Telegram Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1450, 200]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Parse Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Command": {
      "main": [
        [
          {
            "node": "Has Query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Query": {
      "main": [
        [
          {
            "node": "Google Sheets - Read All",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Google Sheets - Read All": {
      "main": [
        [
          {
            "node": "Filter Matches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Matches": {
      "main": [
        [
          {
            "node": "Telegram Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
